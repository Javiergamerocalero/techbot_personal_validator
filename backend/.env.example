# Postgres async connection (asyncpg)
# Local dev: postgresql+asyncpg://qapp_user:qapp_pass@localhost:5432/qapp_employees
# Producción: usar el clúster ya configurado en Contabo, db dedicada
DATABASE_URL=postgresql+asyncpg://qapp_user:qapp_pass@localhost:5432/qapp_employees

# Token para endpoints administrativos (alta de tenants, etc.).
# Generar con `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
ADMIN_TOKEN=changeme_in_production

# CORS — separar por coma, sin espacios.
CORS_ORIGINS=http://localhost:5173,http://localhost:8001

# Nivel de log: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Header opcional que Qapp manda con el nombre del quiosco para
# rastreo en validation_log. Si Qapp no lo manda se loggea como
# "unknown".
KIOSK_NAME_HEADER=X-Kiosk-Name
